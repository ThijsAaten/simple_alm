# ---------------------------------------------------------------------------
# Compiled bytecode
# ---------------------------------------------------------------------------
# These were tracked up to 0adf3bb. They are removed from the index in the same
# commit that adds this file — committing bytecode means every source change
# produces a spurious binary diff, which is part of why five rounds of work
# produced an unreadable working tree.
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Generated on every run
# ---------------------------------------------------------------------------
# The CGB sweep is rewritten by examples/run_cgb_dial.py each time it runs. The
# FROZEN record that docs/VALIDATION_REPORT.md cites is committed separately as
# output/validated_*.csv and must not be ignored.
output/cgb_dial_sweep.csv
output/cgb_dial_sweep_flat_lr.csv

# ---------------------------------------------------------------------------
# Superseded source pickles
# ---------------------------------------------------------------------------
# data/*.pkl were the original calibration inputs. They are numpy-2.x pickles and
# cannot be read by the numpy>=1.26 this repo declares, so the CSVs generated by
# calibration/convert_source_data.py are canonical. Keeping both tracked would
# leave it ambiguous which one is the source. See data/README.md.
data/*.pkl

# ---------------------------------------------------------------------------
# Local environment
# ---------------------------------------------------------------------------
.venv/
venv/
.DS_Store
.pytest_cache/
simple_alm_changes.zip
